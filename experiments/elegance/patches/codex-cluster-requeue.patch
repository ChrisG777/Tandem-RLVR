+def verify_requeued_host(job: str, host: str) -> None:
+    """Allow a same-ID move only after Slurm confirms a restarted single-node job.
+
+    This never admits another live allocation or trusts environment variables
+    as proof of ownership. Unknown scheduler output fails closed.
+    """
+    raw = subprocess.check_output(
+        ['scontrol', 'show', 'job', job, '-o'], text=True,
+        stderr=subprocess.PIPE, timeout=15, env=dict(os.environ, LC_ALL='C'),
+    )
+    fields = dict(piece.split('=', 1) for piece in raw.split() if '=' in piece)
+    if (fields.get('JobId') != job or fields.get('JobState') != 'RUNNING'
+            or fields.get('NumNodes') != '1' or fields.get('NodeList') != host
+            or fields.get('BatchHost') != host
+            or not fields.get('Restarts', '').isdigit() or int(fields['Restarts']) < 1
+            or not fields.get('UserId', '').endswith(f'({os.getuid()})')):
+        raise RuntimeError('Slurm did not confirm this requeued allocation on this host.')
+

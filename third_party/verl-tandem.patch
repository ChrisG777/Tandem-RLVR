+def persist_hf_checkpoint(actor_local_path: str, default_local_dir: str, global_steps: int) -> str | None:
+    """Retain immutable HF weights independently of resume-checkpoint rotation.
+
+    Hard-link on the same filesystem, copy across filesystems, and finish staging
+    before replacing an existing snapshot. A failed copy leaves the old snapshot.
+    """
+    import errno
+    import shutil
+    import tempfile
+
+    def link_or_copy(source, destination):
+        try:
+            os.link(source, destination)
+        except OSError as error:
+            if error.errno != errno.EXDEV:
+                raise
+            shutil.copy2(source, destination)
+        return destination
+
+    hf_src = os.path.join(actor_local_path, "huggingface")
+    if not os.path.isdir(hf_src):
+        return None
+    hf_dst = os.path.join(default_local_dir, "hf", f"global_step_{global_steps}")
+    os.makedirs(os.path.dirname(hf_dst), exist_ok=True)
+    staging = tempfile.mkdtemp(prefix=f".step-{global_steps}-", dir=os.path.dirname(hf_dst))
+    try:
+        shutil.copytree(hf_src, staging, copy_function=link_or_copy, dirs_exist_ok=True)
+        if os.path.islink(hf_dst):
+            os.unlink(hf_dst)
+        elif os.path.exists(hf_dst):
+            shutil.rmtree(hf_dst)
+        os.replace(staging, hf_dst)
+    finally:
+        if os.path.exists(staging):
+            shutil.rmtree(staging)
+    return hf_dst
+
+
+def commit_latest_checkpoint(default_local_dir: str, global_steps: int) -> None:
+    """Atomically commit a synchronous save, then retire other optimizer shards.
+
+    Called only after all model, optimizer, RNG and dataloader writes succeed.
+    Keep the prior optimizer during the save; leave model/HF weights untouched.
+    A failed marker write never removes the previously recoverable state.
+    """
+    from pathlib import Path
+    import tempfile
+
+    root = Path(default_local_dir)
+    current = root / f"global_step_{global_steps}"
+    if not (current / "data.pt").is_file() or not (current / "actor").is_dir():
+        raise RuntimeError(f"Cannot commit incomplete checkpoint: {current}")
+    marker = root / "latest_checkpointed_iteration.txt"
+    with tempfile.NamedTemporaryFile(mode="w", dir=root, prefix=".latest-", delete=False) as f:
+        temporary = Path(f.name)
+        try:
+            f.write(str(global_steps))
+            f.flush()
+            os.fsync(f.fileno())
+        except BaseException:
+            temporary.unlink(missing_ok=True)
+            raise
+    try:
+        os.replace(temporary, marker)
+    finally:
+        temporary.unlink(missing_ok=True)
+    for checkpoint in root.glob("global_step_*"):
+        if checkpoint == current or not checkpoint.name.removeprefix("global_step_").isdigit():
+            continue
+        if checkpoint.is_symlink():
+            continue
+        for role in ("actor", "critic"):
+            directory = checkpoint / role
+            if not directory.is_symlink():
+                for shard in directory.glob("optim_world_size_*_rank_*.pt"):
+                    shard.unlink()
+

# Copy to train/env.sh and edit.

TANDEM_ENV_BIN=${TANDEM_ENV_BIN:-$HOME/miniconda3/envs/tandem-rlvr/bin}
export PATH="$TANDEM_ENV_BIN:$PATH"

export BASE_MODEL=${BASE_MODEL:-Qwen/Qwen3-4B-Instruct-2507}
# export HF_HOME=/path/to/hf-cache

_tandem_repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export CKPT_ROOT=${CKPT_ROOT:-$_tandem_repo/checkpoints}
export DATA_ROOT=${DATA_ROOT:-$_tandem_repo/data}
unset _tandem_repo

export PROJECT_NAME=${PROJECT_NAME:-tandem-rlvr}
# WANDB_SECRETS=$HOME/.config/wandb_secrets.env
if [ -n "${WANDB_SECRETS:-}" ] && [ -f "$WANDB_SECRETS" ]; then
    set -a
    source "$WANDB_SECRETS"
    set +a
fi
if [ -n "${WANDB_API_KEY:-}" ]; then
    export WANDB_MODE=${WANDB_MODE:-online}
else
    export WANDB_MODE=${WANDB_MODE:-offline}
fi
